# Copia este archivo como .env.local y rellena los valores de tu proyecto de
# Supabase (Project Settings → API). Sin ellos, CISNE funciona en modo local.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# La clave PÚBLICA: «publishable» (sb_publishable_…) o, en proyectos antiguos, «anon».
# Nunca pongas aquí la «secret» ni la «service_role».
VITE_SUPABASE_PUBLISHABLE_KEY=
